#!/bin/bash
# Runs once, as root, on the server's first boot (via cloud-init).
# Output is logged to /var/log/cloud-init-output.log on the server.
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

# Point the DuckDNS domain at this server. With ip= left empty, DuckDNS uses
# the IP the request comes from, which is this instance's public IP.
DUCKDNS_TOKEN=$(aws ssm get-parameter \
  --region "${region}" \
  --name "${duckdns_token_param}" \
  --with-decryption \
  --query Parameter.Value \
  --output text)

RESULT=$(curl -fsS "https://www.duckdns.org/update?domains=${duckdns_subdomain}&token=$DUCKDNS_TOKEN&ip=")
if [ "$RESULT" != "OK" ]; then
  echo "DuckDNS update failed: $RESULT"
  exit 1
fi
echo "Pointed ${domain} at this server"

# Private network for Caddy and the app. Containers on it reach each other
# by name. Only Caddy publishes ports to the outside.
docker network create web

# Installs the deploy script. First boot runs it below, and the GitHub
# Actions deploy job runs it again (through SSM Run Command) with a new image.
cat > /usr/local/bin/deploy-app <<'SCRIPT'
#!/bin/bash
# Usage: deploy-app <image>
set -euo pipefail

IMAGE="$1"
ENV_FILE=/etc/acquisitions.env

# Fetch the secrets on every deploy, so a changed parameter takes effect
: > "$ENV_FILE"
chmod 600 "$ENV_FILE"
aws ssm get-parameters-by-path \
  --region "${region}" \
  --path "${param_path}" \
  --with-decryption \
  --query "Parameters[].[Name,Value]" \
  --output text |
while IFS=$'\t' read -r name value; do
  echo "$${name##*/}=$${value}" >> "$ENV_FILE"
done

# Pull first: if it fails, the script stops and the old container keeps running
docker pull "$IMAGE"

# No published port: only Caddy, on the same network, can reach the app
docker rm -f acquisitions 2>/dev/null || true
docker run -d \
  --name acquisitions \
  --restart unless-stopped \
  --network web \
  --log-driver awslogs \
  --log-opt awslogs-region="${region}" \
  --log-opt awslogs-group="${log_group}" \
  --env-file "$ENV_FILE" \
  -e NODE_ENV=production \
  -e PORT=3000 \
  "$IMAGE"

echo "Deployed $IMAGE"
SCRIPT
chmod +x /usr/local/bin/deploy-app

/usr/local/bin/deploy-app "${app_image}"

# Caddy: HTTPS in front of the app. It gets and renews the certificate itself
# and redirects HTTP to HTTPS.
mkdir -p /etc/caddy
cat > /etc/caddy/Caddyfile <<'CADDYFILE'
${domain} {
  reverse_proxy acquisitions:3000
}
CADDYFILE

docker run -d \
  --name caddy \
  --restart unless-stopped \
  --network web \
  -p 80:80 \
  -p 443:443 \
  -v /etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v caddy_data:/data \
  -v caddy_config:/config \
  caddy:2

echo "Caddy started for ${domain}"